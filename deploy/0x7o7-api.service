[Unit]
Description=0x7o7 AI Studio API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/project/0x7o7.service
EnvironmentFile=/etc/0x7o7/api.env
ExecStart=/root/project/0x7o7.service/.venv/bin/gunicorn -c deploy/gunicorn_conf.py main:app
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
