[Unit]
Description=Daily 0x7o7 Postgres backup
After=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/0x7o7/api.env
ExecStart=/bin/bash -lc 'mkdir -p /var/backups/0x7o7 && docker exec -e PGPASSWORD="$POSTGRES_PASSWORD" postgres pg_dump -U "$POSTGRES_USER" "$POSTGRES_DB" | gzip > "/var/backups/0x7o7/service_data-$(date +%%F).sql.gz" && find /var/backups/0x7o7 -type f -name "*.sql.gz" -mtime +7 -delete'
NoNewPrivileges=true
PrivateTmp=true
