RUNTIME_ENV=dev
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://postgres:replace-me@127.0.0.1:5432/service_data
CRM_DATABASE_URL=mysql+pymysql://crm_user:replace-me@127.0.0.1:3306/crm_data?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_ORIGINS=http://localhost:3000,https://preview.0x7o7.top,https://0x7o7.top
COOKIE_SECURE=false

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=studio@example.com
SMTP_PASSWORD=replace-me
SENDER=studio@example.com
LEAD_NOTIFICATION_EMAIL=studio@example.com

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=Qwen/Qwen3-8B
LLM_REQUEST_TIMEOUT=45
LLM_STREAM_TIMEOUT=90
LLM_MAX_RETRIES=1
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

MINIO_SERVICE_URL=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=service

# Optional legacy OCR/Dify integrations. Leave blank when disabled.
OCR_API_KEY=
OCR_API_SECRET=
DIFY_SERVER_URL=
DIFY_KB_SECRET_KEY=
DIFY_CHAT_SECRET_KEY=
DIFY_OCR_SECRET_KEY=
DIFY_DEMO_SECRET_KEY=
